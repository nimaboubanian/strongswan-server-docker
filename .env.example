# strongSwan IPsec server env defaults. Copy to .env (gitignored) and fill in.
# The three REQUIRED vars have no defaults on purpose: the entrypoint exits with
# a FATAL line and the container restart-loops until they are set.
#
# EAP-MSCHAPv2 credentials for IKEv2 clients (Windows/iOS/macOS/Android and
# strongSwan). Comma-separated user:pass; the split is on the FIRST colon, so a
# password may contain colons.
IPSEC_USERS=alice:change-me
# Shared secret for IKEv1 clients (legacy routers). Any string; match it in the
# router's own IPsec settings.
IPSEC_PSK=change-me
# Public IP or DNS name clients dial. It becomes the server certificate's
# subject CN and SAN (IP: for a literal address, DNS: for a name), and native
# IKEv2 clients verify it — an address that does not match will not connect.
VPN_SERVER_ADDR=vpn.example.com
# Address pool handed to clients. Must NOT overlap the container's own subnet
# (the entrypoint refuses to boot if it does) and must not collide with your LAN.
VPN_POOL=10.10.10.0/24
# DNS server pushed to clients via the pool (attr plugin).
CLIENT_DNS=1.1.1.1
# Where decrypted client traffic goes: the vpndogs router's SOCKS in. Change
# these only if the router does not listen at its default address/port.
CHAIN_SOCKS_HOST=vpndogs-router
CHAIN_SOCKS_PORT=1070
# charon log level: 0=-1 (nothing) .. 1=control (default) .. 4=debug
LOG_LEVEL=1